{
  "$schema": "http://json-schema.org/draft-04/schema",
  "type": "object",
  "properties": {
    "verbs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "serviceVerbs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isInternal": {
      "type": "boolean"
    },
    "allowedDomains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedLocationLabels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedLocationLabelsWithCountry": {
      "type": "object",
      "description": "Location labels required to assign this role. Use 'default' key for the global default labels, and ISO 3166-1 alpha-2 country codes for country-specific overrides.",
      "properties": {
        "default": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["default"],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "isAdmin": {
      "type": "boolean"
    },
    "customFilter": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "jsonSchema": {
          "type": "object"
        },
        "uiSchema": {
          "type": "object"
        }
      },
      "required": [
        "version",
        "jsonSchema",
        "uiSchema"
      ]
    }
  },
  "required": [
    "isInternal",
    "allowedDomains",
    "allowedLocationLabels",
    "verbs",
    "serviceVerbs"
  ]
}
